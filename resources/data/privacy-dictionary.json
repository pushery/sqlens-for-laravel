{
    "schema_version": 1,
    "about": "Column-name terms that suggest a column holds PERSONAL data, kept as data so the list reviews as a list and a diff shows exactly which term moved. Written for this package from the naming a real schema uses; no third-party dictionary, compliance catalog or linter rule set was copied. It is a NAME heuristic and nothing more: it never reads a value, so it cannot know whether a column called `notes` holds a diagnosis or whether one called `iban` holds a label. That limit is stated in the finding text as well as here. The seven languages are about the column names a database may CARRY, not about the language this package speaks -- SQLens reports in English only, and a German schema is still a German schema.",
    "matching": {
        "case": "the column name is lowercased before matching",
        "diacritics": "folded before matching, so a column named `religiao` and one named `religiao` with a tilde are one name",
        "camel_case": "split into segments, so `birthDate` matches the same term as `birth_date`",
        "boundary": "a single-word term matches a whole segment of the name, never a substring, so `iban` is not found in `caribbean_id`",
        "multi_word": "a term containing an underscore matches the whole name only, so `tax_id` does not fire on an unrelated `id` segment"
    },
    "groups": {
        "financial": {
            "signal": "strong"
        },
        "health": {
            "signal": "strong"
        },
        "identifiers": {
            "signal": "strong"
        },
        "sensitive": {
            "signal": "weak"
        }
    },
