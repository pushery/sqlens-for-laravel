            "dedupe_group": null,
            "parity_status": "intentionally_not_covered",
            "excludable": true,
            "rationale": "Adding a column with a default rewrote the whole table before PostgreSQL 11 and has been metadata-only since. SQLens supports PostgreSQL 18 and up, so the risk this describes cannot occur on any server it runs against — a rule for it would report a hazard that the supported floor already rules out.",
            "source_url": "https://squawkhq.com/docs/rules/adding-field-with-default"
        },
