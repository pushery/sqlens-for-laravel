{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://docs.pushery.com/sqlens-for-laravel/schemas/online-ddl-matrix.schema.json",
    "title": "InnoDB Online-DDL matrix",
    "description": "The shape of resources/data/online-ddl-matrix.json. Own structure over the facts of the MySQL manual; every entry must cite a source and carry its own prose.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "reference_server",
        "about",
        "entries"
    ],
    "properties": {
        "schema_version": {
            "const": 1
        },
        "reference_server": {
            "type": "string",
            "minLength": 1
        },
        "about": {
            "type": "string",
            "minLength": 1
        },
        "entries": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/entry"
            },
            "minItems": 1
        }
    },
    "$defs": {
        "entry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "operation",
                "algorithm",
                "rebuilds_table",
                "permits_concurrent_dml",
                "lock",
                "min_version",
                "max_version",
                "conditions",
                "sources",
                "notes",
                "stability"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^mysql\\.[a-z_]+\\.[a-z_]+$"
                },
                "operation": {
                    "type": "string",
                    "minLength": 1
                },
                "algorithm": {
                    "enum": [
                        "instant",
                        "inplace",
                        "copy",
                        "not_applicable"
                    ]
                },
                "rebuilds_table": {
                    "type": "boolean"
                },
                "permits_concurrent_dml": {
                    "type": "boolean"
                },
                "lock": {
                    "enum": [
                        "none",
                        "shared",
                        "exclusive"
                    ]
                },
                "min_version": {
                    "type": "string",
                    "minLength": 1
                },
                "max_version": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "conditions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/condition"
                    }
                },
                "sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/source"
                    }
                },
                "notes": {
                    "type": "string",
                    "minLength": 1
                },
                "stability": {
                    "enum": [
                        "stable",
                        "preview"
                    ]
                }
            }
        },
        "condition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "text"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                },
                "text": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "url",
                "anchor",
                "retrieved"
            ],
            "properties": {
                "url": {
                    "type": "string",
                    "format": "uri"
                },
                "anchor": {
                    "type": "string",
                    "minLength": 1
                },
                "retrieved": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
            }
        }
    }
}