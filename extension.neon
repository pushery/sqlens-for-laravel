# SQLens — the analyse suite's PHPStan extension.
#
# A consuming project pulls this in through composer's phpstan plugin (see composer.json
# `extra.phpstan.includes`) or by hand:
#
#     includes:
#         - vendor/pushery/sqlens-for-laravel/extension.neon
#
# WHAT IT IS FOR. The safety rules elsewhere in this package read statements the database actually
# received; these read the CODE that hands SQL over, which is the only place a raw-SQL call site is
# visible at all. The two answer different questions and neither replaces the other.
#
# NOT A TYPE CHECKER, and not a taint analysis. Types are phpstan-dba's subject and Eloquent is
# Larastan's; this extension collects raw-SQL call sites so the package's own rules can judge them.
# Promising taint tracking would be a claim this design cannot keep — the limitation is stated in
# the rules themselves, not only here.
# CONFIGURATION. A project overrides these under `parameters.sqlens.analyse` in its own
# `phpstan.neon`. Three things are worth knowing before changing them:
#
#   policy: off | documented | strict
#       How hard the justification duty presses. `off` silences the POLICY rule and nothing else —
#       the injection rules report an exposure rather than a missing sentence, and severity is not
#       level-gated in this package. One line of neon must never be able to disable half the
#       security surface.
#
#       The schema below accepts a bool as well as a string, and that is not laxity: NEON reads the
#       bare word `off` as boolean FALSE. Without it, the most likely thing a developer writes —
#       the mode's own name, unquoted — is refused with a message about types rather than about the
#       setting. `on`/`yes` is still refused, because it names no mode and both remaining ones are
#       "on".
#
#   exclude_paths
#       Paths the justification duty does not apply to; generated code is the case it exists for.
#       Every entry must resolve to something that exists, or the run stops. A path that matches
#       nothing excludes nothing, and the exemption a project believes it has would silently not
#       apply.
#
#       THE INJECTION RULES DO NOT READ THIS LIST, and that is deliberate rather than an omission.
#       This setting governs one axis — whether a raw statement owes a written reason. Whether a
#       runtime value was assembled into statement text is the other, and it is an exposure rather
#       than a missing sentence. A path list that silenced both would let one line of neon disable
#       half the security surface, which is the same reason `policy: off` reaches the policy rule
#       and nothing else.
#
#       So where an injection finding cannot be acted on — an identifier, a schema name, DDL built
#       from an enum, all positions where no binding form exists — the exemption goes in PHPStan's
#       own mechanism, which is rule-precise and can be scoped to a path:
#
#           parameters:
#               ignoreErrors:
#                   -
#                       identifier: sqlens.rawSql.interpolation
#                       paths:
#                           - database/migrations
#
#       That removes exactly those findings and leaves every other rule reporting.
#
#       It is worth knowing what it does NOT do, because this list behaves the other way: an entry
#       here that matches nothing stops the run. An ignoreErrors entry naming a file the run
#       analyses, for a finding that file no longer produces, is accepted in silence — measured,
#       rather than assumed from the default of `reportUnmatchedIgnoredErrors`, which does report an
#       entry a NARROWED run never reached but not this case. So an exemption whose call site was
#       rewritten years ago goes on sitting in a project's configuration looking like protection.
#       Review them when the code under them moves.
#
#   justification_placeholders
#       Reasons that stop counting as reasons under `strict` — `todo`, `tbd`, whatever a team
#       actually types. Empty is refused in every mode and needs no entry.
#
# The SCHEMA below is what refuses an unknown key or a wrong type; PHPStan answers that half
# natively and this package does not re-implement it. A wrong VALUE — a mode that does not exist,
# a path that is not there — is refused by `AnalyseConfig`, which throws rather than falling back.
parametersSchema:
    sqlens: structure([
        analyse: structure([
            policy: anyOf(string(), bool())
            exclude_paths: listOf(string())
            justification_placeholders: listOf(string())
        ])
    ])

parameters:
    sqlens:
        analyse:
            policy: documented
            exclude_paths: []
            justification_placeholders: []

services:
    -
        class: Pushery\SQLens\Analyse\AnalyseConfig
        arguments:
            policy: %sqlens.analyse.policy%
            excludePaths: %sqlens.analyse.exclude_paths%
            justificationPlaceholders: %sqlens.analyse.justification_placeholders%
    -
        class: Pushery\SQLens\Analyse\RawSqlCallCollector
        tags:
            - phpstan.collector
    # NOT tagged as a collector: it is the shared unit both justification collectors ask "does this
    # attribute list carry a reason this run accepts". It is registered rather than left to each
    # constructor's default, because a default would build its own AnalyseConfig and answer under the
    # SHIPPED policy while the rest of the run used the project's.
    -
        class: Pushery\SQLens\Analyse\RawSqlReason
    -
        class: Pushery\SQLens\Analyse\JustificationCollector
        tags:
            - phpstan.collector
    # The second justification channel, joined by POSITION rather than by name — a free function and
    # a closure have no name a call site inside them reports, and a Pest test body is always the
    # second of those.
    -
        class: Pushery\SQLens\Analyse\JustificationSpanCollector
        tags:
            - phpstan.collector
    -
        class: Pushery\SQLens\Analyse\RawSqlFragmentCollector
        tags:
            - phpstan.collector
    -
        class: Pushery\SQLens\Analyse\RawSqlConnectionCallCollector
        tags:
            - phpstan.collector
    -
        class: Pushery\SQLens\Analyse\RawSqlExpressionCollector
        tags:
            - phpstan.collector
    -
        class: Pushery\SQLens\Analyse\DynamicIdentifierCollector
        tags:
            - phpstan.collector
    -
        class: Pushery\SQLens\Analyse\UnjustifiedRawSqlRule
        tags:
            - phpstan.rules.rule
    -
        class: Pushery\SQLens\Analyse\StaleRawSqlReasonRule
        tags:
            - phpstan.rules.rule
    -
        class: Pushery\SQLens\Analyse\RawInterpolationRule
        tags:
            - phpstan.rules.rule
    -
        class: Pushery\SQLens\Analyse\DynamicIdentifierRule
        tags:
            - phpstan.rules.rule
